# macOS
.DS_Store
.AppleDouble
.LSOverride

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Env / secrets
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS / misc
Thumbs.db

# Node / Next.js
node_modules/
.next/
out/
dist/
next-env.d.ts
*.tsbuildinfo

# Constellation runtime state (live subagent tracking) — but the
# generated descriptions sidecar is committed so collaborators see
# them without re-running `constellation describe`.
# (Note: pattern is .constellation/* not .constellation/ so the negates
# below can match — git skips ignored dirs entirely otherwise.)
.constellation/*
!.constellation/descriptions.json
!.constellation/descriptions.yaml
!.constellation/descriptions.yml

# Claude Code — keep user-local overrides out of the repo
.claude/settings.local.json
.claude/scheduled_tasks.lock

# Compound Engineering — local-only config
.compound-engineering/*.local.yaml

# Compound Engineering — per-run review artifacts (per-reviewer JSON, etc.)
.context/
